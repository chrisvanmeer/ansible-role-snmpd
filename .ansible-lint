---
# ansible-lint configuration
# https://ansible.readthedocs.io/projects/lint/configuring/

# Ruleset/profile that determines which rules are active.
profile: production

# Return non-zero exit code on warnings as well as errors.
strict: true

# Paths that are explicitly excluded from linting, relative to this file.
exclude_paths:
  - .github/
  # tests/compat.yml is a CI-only scaffold that references the role from outside a
  # roles/ directory, which cannot be resolved without an extra ANSIBLE_ROLES_PATH.
  # It is a static import so `ansible-playbook --syntax-check` still validates the
  # role with the ansible-core version declared in meta/main.yml, and yamllint
  # still checks its formatting.
  - tests/
