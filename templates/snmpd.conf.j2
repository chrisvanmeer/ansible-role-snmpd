{{ ansible_managed | comment }}
{# Directives that are not configured are omitted entirely: every optional part
   below is rendered with an inline conditional expression rather than a block
   tag, because Ansible renders templates with trim_blocks enabled and a line
   ending in a block tag loses its newline, which merges list items together. #}
{% if snmpd_syslocation is defined %}
{{ '%-15s' | format("syslocation") }} {{ snmpd_syslocation }}
{% endif %}
{% if snmpd_syscontact is defined %}
{{ '%-15s' | format("syscontact") }} {{ snmpd_syscontact }}
{% endif %}
{% if snmpd_sysservices is defined %}
{{ '%-15s' | format("sysServices") }} {{ snmpd_sysservices }}
{% endif %}
{% if snmpd_agent_address is defined %}
{{ '%-15s' | format("agentaddress") }} {{ snmpd_agent_address }}
{% endif %}
{% if snmpd_master_agentx | default(false) | bool %}
{{ '%-15s' | format("master") }} agentx
{% endif %}
{% for view in snmpd_views | default([]) %}
view {{ '%-10s' | format(view.name) }} {{ view.type }} {{ view.subtree }}{{ ' ' ~ view.mask if view.mask is defined else '' }}
{% endfor %}
{% for security_name in snmpd_security_names | default([]) %}
com2sec {{ security_name.name }} {{ security_name.source }} {{ security_name.community }}
{% endfor %}
{% for group in snmpd_groups | default([]) %}
group {{ group.name }} {{ group.security_model }} {{ group.security_name }}
{% endfor %}
{% for access in snmpd_accesses | default([]) %}
access {{ access.group }} "{{ access.context }}" {{ access.security_model }} {{ access.security_level }} {{ access.prefix }} {{ access.read }} {{ access.write }} {{ access.notif }}
{% endfor %}
{% if snmpd_dontlogtcpwrappersconnects is defined %}
{{ '%-22s' | format("dontLogTCPWrappersConnects") }} {{ snmpd_dontlogtcpwrappersconnects }}
{% endif %}
{% for process in snmpd_processes | default([]) %}
proc {{ process.name }}{{ ' ' ~ process.maximum if process.maximum is defined else '' }}{{ ' ' ~ process.minimum if process.minimum is defined else '' }}
{% endfor %}
{% for script in snmpd_scripts | default([]) %}
exec {{ script.name }} {{ script.program }} {{ script.arguments }}
{% endfor %}
{% for disk in snmpd_disks | default([]) %}
disk {{ disk.path }}{{ ' ' ~ disk.minimum if disk.minimum is defined else '' }}
{% endfor %}
{% if snmpd_load is defined %}
load {{ snmpd_load.one_minute_average }} {{ snmpd_load.five_minute_average }} {{ snmpd_load.fifteen_minute_average }}
{% endif %}
{% for user in snmpd_v3_users | default([]) %}
{{ '%-15s' | format("rouser" if user.readonly | default(false) | bool else "rwuser") }} {{ user.username }}{{ ' authpriv' if user.authpriv | default(false) | bool else '' }}
{% endfor %}
